# Copy to .env and fill in. Never commit the real .env.
MODEM_URL=http://192.168.0.1
MODEM_PASSWORD=CHANGE_ME
POLL_INTERVAL=30s

# Re-login backoff: after a failed login, wait BASE, then double each further
# failure up to MAX. Prevents the collector from tripping the modem's
# brute-force login lockout during an outage.
LOGIN_BACKOFF_BASE=60s
LOGIN_BACKOFF_MAX=15m

# Grafana admin login (http://localhost:3001)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
